{
  "openapi": "3.0.1",
  "info": {
    "title": "Employee API (LLM Enabled)",
    "version": "v1",
    "description": "API for managing employees and employee-specific schedule/shift lookups."
  },
  "servers": [
    {
      "url": "http://localhost/employeeapi",
      "description": "Development (local IIS virtual directory)",
      "x-environment-name": "development"
    },
    {
      "url": "https://nlp-employee-api.azurewebsites.net",
      "description": "Production",
      "x-environment-name": "production"
    }
  ],
  "paths": {
    "/api/employees": {
      "get": {
        "tags": [
          "Employee"
        ],
        "operationId": "searchEmployees",
        "summary": "Search employees",
        "description": "Search employees by first name, last name, full name, or email prefix.",
        "x-operation-type": "query",
        "x-intent": [
          "find employee",
          "search employee",
          "lookup employee",
          "get employee by name"
        ],
        "x-resolution": {
          "entity": "employee",
          "queryParam": "query",
          "disambiguation": {
            "enabled": true,
            "prompt": "I found multiple employees matching that name. Which one did you mean?",
            "displayFields": [
              "id",
              "firstName",
              "lastName",
              "email",
              "roleId"
            ]
          }
        },
        "parameters": [
          {
            "name": "query",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Employees",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Employee"
                  }
                },
                "example": [
                  {
                    "id": 1,
                    "firstName": "John",
                    "lastName": "Doe",
                    "email": "john.doe@scheduler.local",
                    "roleId": 1
                  },
                  {
                    "id": 2,
                    "firstName": "John",
                    "lastName": "Smith",
                    "email": "john.smith@scheduler.local",
                    "roleId": 2
                  }
                ]
              }
            }
          },
          "400": {
            "description": "Invalid query"
          }
        }
      },
      "post": {
        "tags": [
          "Employee"
        ],
        "operationId": "createEmployee",
        "summary": "Create employee",
        "x-operation-type": "mutation",
        "x-intent": [
          "create employee",
          "add employee",
          "new employee"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateEmployeeRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Created employee",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Employee"
                },
                "example": {
                  "id": 10,
                  "firstName": "Jane",
                  "lastName": "Smith",
                  "email": "jane.smith@scheduler.local",
                  "roleId": 1
                }
              }
            }
          },
          "400": {
            "description": "Invalid input"
          }
        }
      }
    },
    "/api/employees/{employeeId}": {
      "get": {
        "tags": [
          "Employee"
        ],
        "operationId": "getEmployeeById",
        "x-operation-type": "query",
        "x-intent": [
          "get employee",
          "view employee",
          "employee details"
        ],
        "parameters": [
          {
            "name": "employeeId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Employee",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Employee"
                }
              }
            }
          },
          "404": {
            "description": "Employee not found"
          }
        }
      },
      "put": {
        "tags": [
          "Employee"
        ],
        "operationId": "updateEmployee",
        "summary": "Update employee",
        "x-operation-type": "mutation",
        "x-intent": [
          "update employee",
          "edit employee"
        ],
        "parameters": [
          {
            "name": "employeeId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateEmployeeRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated"
          },
          "400": {
            "description": "Invalid input"
          }
        }
      },
      "delete": {
        "tags": [
          "Employee"
        ],
        "operationId": "deleteEmployee",
        "x-operation-type": "mutation",
        "x-intent": [
          "delete employee",
          "remove employee"
        ],
        "parameters": [
          {
            "name": "employeeId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Deleted"
          }
        }
      }
    },
    "/api/employees/{employeeId}/shifts": {
      "get": {
        "tags": [
          "Shifts"
        ],
        "operationId": "getEmployeeShifts",
        "x-operation-type": "query",
        "x-intent": [
          "get employee shifts",
          "view employee schedule",
          "show shifts for employee"
        ],
        "parameters": [
          {
            "name": "employeeId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "startDate",
            "in": "query",
            "description": "Optional inclusive start date filter (YYYY-MM-DD)",
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "endDate",
            "in": "query",
            "description": "Optional inclusive end date filter (YYYY-MM-DD)",
            "schema": {
              "type": "string",
              "format": "date"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Shifts",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Shift"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/employees/{employeeId}/employeeScheduleGroups": {
      "get": {
        "tags": [
          "Schedule"
        ],
        "operationId": "getEmployeeScheduleGroups",
        "summary": "Get schedulable resources for employee",
        "description": "Returns schedules the employee can be scheduled on.",
        "x-operation-type": "query",
        "x-intent": [
          "get schedules an employee can be scheduled on",
          "list schedulable schedules for employee",
          "which schedules can this employee work on"
        ],
        "parameters": [
          {
            "name": "employeeId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "ScheduleGroups",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Schedule"
                  }
                }
              }
            }
          },
          "403": {
            "description": "Forbidden"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Employee": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "firstName": {
            "type": "string"
          },
          "lastName": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "roleId": {
            "type": "integer",
            "description": "1 = Employee, 2 = Supervisor"
          }
        }
      },
      "Schedule": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "name": {
            "type": "string"
          },
          "startDate": {
            "type": "string"
          },
          "endDate": {
            "type": "string"
          }
        }
      },
      "Shift": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "employeeId": {
            "type": "integer"
          },
          "scheduleGroupId": {
            "type": "integer"
          },
          "employeeName": {
            "type": "string"
          },
          "start": {
            "type": "string",
            "format": "date-time"
          },
          "durationHours": {
            "type": "integer"
          }
        }
      },
      "CreateEmployeeRequest": {
        "type": "object",
        "required": [
          "firstName",
          "lastName",
          "email",
          "roleId"
        ],
        "properties": {
          "firstName": {
            "type": "string"
          },
          "lastName": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "roleId": {
            "type": "integer"
          }
        }
      },
      "UpdateEmployeeRequest": {
        "type": "object",
        "properties": {
          "firstName": {
            "type": "string"
          },
          "lastName": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "roleId": {
            "type": "integer"
          }
        }
      }
    }
  }
}
