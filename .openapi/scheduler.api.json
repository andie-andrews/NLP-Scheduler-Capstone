{
  "openapi": "3.0.1",
  "info": {
    "title": "Scheduler API (LLM Enabled)",
    "version": "v1",
    "description": "Full API for managing employees, schedules, and shifts with AI-driven workflows."
  },
  "servers": [
    {
      "url": "http://localhost/schedulerapi",
      "description": "Development (local IIS virtual directory)",
      "x-environment-name": "development"
    },
    {
      "url": "https://nlp-scheduler-api-ehc5bhhdeparezd7.canadacentral-01.azurewebsites.net",
      "description": "Production",
      "x-environment-name": "production"
    }
  ],
  "paths": {
    "/api/auth/login": {
      "post": {
        "tags": [
          "Auth"
        ],
        "operationId": "loginUser",
        "x-operation-type": "mutation",
        "x-intent": [
          "login",
          "authenticate",
          "sign in"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "JWT token",
            "content": {
              "application/json": {
                "example": {
                  "token": "jwt-token"
                }
              }
            }
          },
          "401": {
            "description": "Invalid credentials"
          }
        }
      }
    },
    "/api/schedules": {
      "get": {
        "tags": [
          "Schedule"
        ],
        "operationId": "getSchedules",
        "x-operation-type": "query",
        "x-intent": [
          "list schedules",
          "get schedules",
          "view schedules"
        ],
        "x-resolution": {
          "entity": "schedule",
          "queryParam": "query",
          "disambiguation": {
            "enabled": true,
            "prompt": "I found multiple schedules matching that name. Which one did you mean?",
            "displayFields": [
              "id",
              "name"
            ]
          }
        },
        "parameters": [
          {
            "name": "query",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Schedules",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Schedule"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Schedule"
        ],
        "operationId": "createSchedule",
        "x-operation-type": "mutation",
        "x-intent": [
          "create schedule",
          "add schedule",
          "new schedule"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateScheduleRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Created schedule id",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "integer"
                    }
                  },
                  "required": [
                    "id"
                  ]
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid employeeId claim in JWT."
          }
        },
        "summary": "Create schedule and assign creator as manager",
        "description": "Creates a new schedule and automatically assigns the authenticated user (employeeId claim) as a manager in ScheduleManagers."
      }
    },
    "/api/schedules/{scheduleId}/employees": {
      "get": {
        "tags": [
          "Schedule"
        ],
        "operationId": "getScheduleEmployees",
        "x-operation-type": "query",
        "x-intent": [
          "get schedule employees",
          "who is assigned to schedule",
          "list employees in schedule"
        ],
        "parameters": [
          {
            "name": "scheduleId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Employees",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Employee"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/schedules/{scheduleId}/shifts": {
      "get": {
        "tags": [
          "Shifts"
        ],
        "operationId": "getScheduleShifts",
        "x-operation-type": "query",
        "x-intent": [
          "get schedule shifts",
          "view schedule shifts",
          "show shifts for schedule"
        ],
        "parameters": [
          {
            "name": "scheduleId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "startDate",
            "in": "query",
            "description": "Optional inclusive start date filter (YYYY-MM-DD)",
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "endDate",
            "in": "query",
            "description": "Optional inclusive end date filter (YYYY-MM-DD)",
            "schema": {
              "type": "string",
              "format": "date"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Shifts",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Shift"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Shifts"
        ],
        "operationId": "createShift",
        "x-operation-type": "mutation",
        "x-intent": [
          "schedule shift",
          "assign shift",
          "create shift"
        ],
        "x-dependencies": {
          "scheduleId": {
            "resolvedBy": "getSchedules"
          }
        },
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateShiftRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Created shift",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Shift"
                }
              }
            }
          }
        }
      }
    },
    "/api/shifts/{shiftId}": {
      "delete": {
        "tags": [
          "Shifts"
        ],
        "operationId": "deleteShift",
        "x-operation-type": "mutation",
        "x-intent": [
          "delete shift",
          "remove shift",
          "cancel shift"
        ],
        "parameters": [
          {
            "name": "shiftId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Deleted"
          }
        }
      }
    },
    "/api/health": {
      "get": {
        "tags": [
          "System"
        ],
        "operationId": "healthCheck",
        "x-operation-type": "query",
        "x-intent": [
          "check api health",
          "is system running"
        ],
        "responses": {
          "200": {
            "description": "API is healthy"
          }
        }
      }
    },
    "/api/schedules/{scheduleId}/scheduleEmployees/{employeeId}": {
      "post": {
        "tags": [
          "Schedule"
        ],
        "operationId": "addEmployeeToSchedule",
        "x-operation-type": "mutation",
        "x-intent": [
          "add employee to schedule",
          "assign employee to schedule",
          "add manager to schedule"
        ],
        "parameters": [
          {
            "name": "scheduleId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "employeeId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Employee added to schedule"
          }
        }
      },
      "delete": {
        "tags": [
          "Schedule"
        ],
        "operationId": "removeEmployeeFromSchedule",
        "x-operation-type": "mutation",
        "x-intent": [
          "remove employee from schedule",
          "unassign employee from schedule",
          "remove manager from schedule"
        ],
        "parameters": [
          {
            "name": "scheduleId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "employeeId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Employee removed from schedule"
          }
        }
      }
    },
    "/api/schedules/{scheduleId}": {
      "delete": {
        "tags": [
          "Schedule"
        ],
        "operationId": "deleteSchedule",
        "x-operation-type": "mutation",
        "x-intent": [
          "delete schedule",
          "remove schedule",
          "cancel schedule"
        ],
        "parameters": [
          {
            "name": "scheduleId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Schedule deleted"
          }
        }
      }
    },
    "/api/managers/{managerId}/managerSchedules": {
      "get": {
        "tags": [
          "Schedule"
        ],
        "operationId": "getManagerSchedules",
        "summary": "Get manageable resources for manager",
        "description": "Returns schedules the manager can create shifts for.",
        "x-operation-type": "query",
        "x-intent": [
          "get schedules a manager can schedule on",
          "list manageable schedules for manager",
          "which schedules can this manager create shifts for"
        ],
        "parameters": [
          {
            "name": "managerId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Schedules",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Schedule"
                  }
                }
              }
            }
          },
          "403": {
            "description": "Forbidden"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Employee": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "firstName": {
            "type": "string"
          },
          "lastName": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "roleId": {
            "type": "integer",
            "description": "1 = Employee, 2 = Supervisor"
          }
        }
      },
      "Schedule": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "name": {
            "type": "string"
          },
          "startDate": {
            "type": "string"
          },
          "endDate": {
            "type": "string"
          }
        }
      },
      "Shift": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "employeeId": {
            "type": "integer"
          },
          "scheduleId": {
            "type": "integer"
          },
          "employeeName": {
            "type": "string"
          },
          "start": {
            "type": "string",
            "format": "date-time"
          },
          "durationHours": {
            "type": "integer"
          }
        }
      },
      "CreateEmployeeRequest": {
        "type": "object",
        "required": [
          "firstName",
          "lastName",
          "email",
          "roleId"
        ],
        "properties": {
          "firstName": {
            "type": "string"
          },
          "lastName": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "roleId": {
            "type": "integer"
          }
        }
      },
      "UpdateEmployeeRequest": {
        "type": "object",
        "properties": {
          "firstName": {
            "type": "string"
          },
          "lastName": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "roleId": {
            "type": "integer"
          }
        }
      }
    }
  }
}
