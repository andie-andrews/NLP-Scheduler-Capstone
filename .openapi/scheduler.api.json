{
  "openapi": "3.0.1",
  "info": {
    "title": "Scheduler API (LLM Enabled)",
    "version": "v1",
    "description": "Full API for managing employees, schedules, and shifts with AI-driven workflows."
  },
  "servers": [
    {
      "url": "http://localhost/schedulerapi",
      "description": "Development (local IIS virtual directory)",
      "x-environment-name": "development"
    },
    {
      "url": "https://nlp-scheduler-api-ehc5bhhdeparezd7.canadacentral-01.azurewebsites.net",
      "description": "Production",
      "x-environment-name": "production"
    }
  ],
  "paths": {
    "/api/auth/login": {
      "post": {
        "tags": [
          "Auth"
        ],
        "operationId": "loginUser",
        "x-operation-type": "mutation",
        "x-intent": [
          "login",
          "authenticate",
          "sign in"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "JWT token",
            "content": {
              "application/json": {
                "example": {
                  "token": "jwt-token"
                }
              }
            }
          },
          "401": {
            "description": "Invalid credentials"
          }
        }
      }
    },
    "/api/schedule-groups": {
      "get": {
        "tags": [
          "Schedule"
        ],
        "operationId": "getScheduleGroups",
        "x-operation-type": "query",
        "x-intent": [
          "list schedules",
          "get schedules",
          "view schedules"
        ],
        "x-resolution": {
          "entity": "schedule",
          "queryParam": "query",
          "disambiguation": {
            "enabled": true,
            "prompt": "I found multiple schedules matching that name. Which one did you mean?",
            "displayFields": [
              "id",
              "name"
            ]
          }
        },
        "parameters": [
          {
            "name": "query",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "ScheduleGroups",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ScheduleGroup"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Schedule"
        ],
        "operationId": "createScheduleGroup",
        "x-operation-type": "mutation",
        "x-intent": [
          "create schedule group",
          "add schedule group",
          "new schedule group",
          "create manager group",
          "add manager group"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateScheduleGroupRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Created schedule id",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "integer"
                    }
                  },
                  "required": [
                    "id"
                  ]
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid employeeId claim in JWT."
          }
        },
        "summary": "Create schedule group and assign creator as manager",
        "description": "Creates a new schedule group and automatically assigns the authenticated user (employeeId claim) as a manager in ScheduleGroupManagers."
      }
    },
    "/api/schedule-groups/{scheduleGroupId}/employees": {
      "get": {
        "tags": [
          "Schedule"
        ],
        "operationId": "getScheduleGroupEmployees",
        "x-operation-type": "query",
        "x-intent": [
          "get employees for schedule group",
          "who is assigned to schedule group",
          "list employees in schedule group"
        ],
        "parameters": [
          {
            "name": "scheduleGroupId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Employees",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Employee"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/schedule-groups/{scheduleGroupId}/shifts": {
      "get": {
        "tags": [
          "Shifts"
        ],
        "operationId": "getScheduleShifts",
        "x-operation-type": "query",
        "x-intent": [
          "get shifts for schedule group",
          "view schedule group shifts",
          "show shifts for schedule group"
        ],
        "parameters": [
          {
            "name": "scheduleGroupId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "startDate",
            "in": "query",
            "description": "Optional inclusive start date filter (YYYY-MM-DD)",
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "endDate",
            "in": "query",
            "description": "Optional inclusive end date filter (YYYY-MM-DD)",
            "schema": {
              "type": "string",
              "format": "date"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Shifts",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Shift"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Shifts"
        ],
        "operationId": "createShift",
        "x-operation-type": "mutation",
        "x-intent": [
          "schedule shift",
          "assign shift",
          "create shift"
        ],
        "x-dependencies": {
          "scheduleGroupId": {
            "resolvedBy": "getScheduleGroups"
          }
        },
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateShiftRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Created shift",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Shift"
                }
              }
            }
          }
        }
      }
    },
    "/api/shifts/{shiftId}": {
      "delete": {
        "tags": [
          "Shifts"
        ],
        "operationId": "deleteShift",
        "x-operation-type": "mutation",
        "x-intent": [
          "delete shift",
          "remove shift",
          "cancel shift"
        ],
        "parameters": [
          {
            "name": "shiftId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Deleted"
          }
        }
      }
    },
