            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Employee added to schedule"
          }
        }
      },
      "delete": {
        "tags": [
          "Schedule"
        ],
        "operationId": "removeEmployeeFromScheduleGroup",
        "x-operation-type": "mutation",
        "x-intent": [
          "remove employee from schedule group",
          "unassign employee from schedule group",
          "remove manager from schedule group",
          "remove manager from manager group"
        ],
        "parameters": [
          {
            "name": "scheduleGroupId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "employeeId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Employee removed from schedule"
          }
