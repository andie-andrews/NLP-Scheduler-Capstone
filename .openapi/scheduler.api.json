          },
          "scheduleGroupId": {
            "type": "integer"
          },
          "employeeName": {
            "type": "string"
          },
          "start": {
            "type": "string",
            "format": "date-time"
          },
          "durationHours": {
            "type": "integer"
          }
        }
      },
      "CreateEmployeeRequest": {
        "type": "object",
        "required": [
