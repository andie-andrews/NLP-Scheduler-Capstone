{
  "openapi": "3.0.1",
  "info": {
    "title": "Scheduler API (LLM Enabled)",
    "version": "v1",
    "description": "Full API for managing employees, schedules, and shifts with AI-driven workflows."
  },
  "servers": [
    {
      "url": "https://localhost:7259"
    }
  ],
  "paths": {
    "/api/auth/login": {
      "post": {
        "tags": [
          "Auth"
        ],
        "operationId": "loginUser",
        "x-operation-type": "mutation",
        "x-intent": [
          "login",
          "authenticate",
          "sign in"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "JWT token",
            "content": {
              "application/json": {
                "example": {
                  "token": "jwt-token"
                }
              }
            }
          },
          "401": {
            "description": "Invalid credentials"
          }
        }
      }
    },
    "/api/employees": {
      "get": {
        "tags": [
          "Employee"
        ],
        "operationId": "searchEmployees",
        "summary": "Search employees",
        "description": "Search employees by first, last, or full name.",
        "x-operation-type": "query",
        "x-intent": [
          "find employee",
          "search employee",
          "lookup employee",
          "get employee by name"
        ],
        "x-resolution": {
          "entity": "employee",
          "queryParam": "query",
          "disambiguation": {
            "enabled": true,
            "prompt": "I found multiple employees matching that name. Which one did you mean?",
            "displayFields": [
              "id",
              "firstName",
              "lastName",
              "roleId"
            ]
          }
        },
        "parameters": [
          {
            "name": "query",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Employees",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Employee"
                  }
                },
                "example": [
                  {
                    "id": 1,
                    "firstName": "John",
                    "lastName": "Doe",
                    "roleId": 1
                  },
                  {
                    "id": 2,
                    "firstName": "John",
                    "lastName": "Smith",
                    "roleId": 2
                  }
                ]
              }
            }
          },
          "400": {
            "description": "Invalid query"
          }
        }
      },
      "post": {
        "tags": [
          "Employee"
        ],
        "operationId": "createEmployee",
        "summary": "Create employee",
        "x-operation-type": "mutation",
        "x-intent": [
          "create employee",
          "add employee",
          "new employee"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateEmployeeRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Created employee",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Employee"
                },
                "example": {
                  "id": 10,
                  "firstName": "Jane",
                  "lastName": "Smith",
                  "roleId": 1
                }
              }
            }
          },
          "400": {
            "description": "Invalid input"
          }
        }
      }
    },
    "/api/employees/{employeeId}": {
      "get": {
        "tags": [
          "Employee"
        ],
        "operationId": "getEmployeeById",
        "x-operation-type": "query",
        "x-intent": [
          "get employee",
          "view employee",
          "employee details"
        ],
        "parameters": [
          {
            "name": "employeeId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Employee",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Employee"
                }
              }
            }
          },
          "404": {
            "description": "Employee not found"
          }
        }
      },
      "put": {
        "tags": [
          "Employee"
        ],
        "operationId": "updateEmployee",
        "summary": "Update employee",
        "x-operation-type": "mutation",
        "x-intent": [
          "update employee",
          "edit employee"
        ],
        "parameters": [
          {
            "name": "employeeId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateEmployeeRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated"
          },
          "400": {
            "description": "Invalid input"
          }
        }
      },
      "delete": {
        "tags": [
          "Employee"
        ],
        "operationId": "deleteEmployee",
        "x-operation-type": "mutation",
        "x-intent": [
          "delete employee",
          "remove employee"
        ],
        "parameters": [
          {
            "name": "employeeId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Deleted"
          }
        }
      }
    },
    "/api/employees/{employeeId}/shifts": {
      "get": {
        "tags": [
          "Shifts"
        ],
        "operationId": "getEmployeeShifts",
        "x-operation-type": "query",
        "x-intent": [
          "get employee shifts",
          "view employee schedule",
          "show shifts for employee"
        ],
        "parameters": [
          {
            "name": "employeeId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "startDate",
            "in": "query",
            "description": "Optional inclusive start date filter (YYYY-MM-DD)",
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "endDate",
            "in": "query",
            "description": "Optional inclusive end date filter (YYYY-MM-DD)",
            "schema": {
              "type": "string",
              "format": "date"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Shifts",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Shift"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/schedules": {
      "get": {
        "tags": [
          "Schedule"
        ],
        "operationId": "getSchedules",
        "x-operation-type": "query",
        "x-intent": [
          "list schedules",
          "get schedules",
          "view schedules"
        ],
        "x-resolution": {
          "entity": "schedule",
          "queryParam": "query",
          "disambiguation": {
            "enabled": true,
            "prompt": "I found multiple schedules matching that name. Which one did you mean?",
            "displayFields": [
              "id",
              "name"
            ]
          }
        },
        "parameters": [
          {
            "name": "query",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Schedules",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Schedule"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Schedule"
        ],
        "operationId": "createSchedule",
        "x-operation-type": "mutation",
        "x-intent": [
          "create schedule",
          "add schedule",
          "new schedule"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateScheduleRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Created schedule",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Schedule"
                }
              }
            }
          }
        }
      }
    },
    "/api/schedules/{scheduleId}/employees": {
      "get": {
        "tags": [
          "Schedule"
        ],
        "operationId": "getScheduleEmployees",
        "x-operation-type": "query",
        "x-intent": [
          "get schedule employees",
          "who is assigned to schedule",
          "list employees in schedule"
        ],
        "parameters": [
          {
            "name": "scheduleId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Employees",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Employee"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/schedules/{scheduleId}/shifts": {
      "get": {
        "tags": [
          "Shifts"
        ],
        "operationId": "getScheduleShifts",
        "x-operation-type": "query",
        "x-intent": [
          "get schedule shifts",
          "view schedule shifts",
          "show shifts for schedule"
        ],
        "parameters": [
          {
            "name": "scheduleId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "startDate",
            "in": "query",
            "description": "Optional inclusive start date filter (YYYY-MM-DD)",
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "endDate",
            "in": "query",
            "description": "Optional inclusive end date filter (YYYY-MM-DD)",
            "schema": {
              "type": "string",
              "format": "date"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Shifts",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Shift"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Shifts"
        ],
        "operationId": "createShift",
        "x-operation-type": "mutation",
        "x-intent": [
          "schedule shift",
          "assign shift",
          "create shift"
        ],
        "x-dependencies": {
          "employeeId": {
            "resolvedBy": "searchEmployees"
          },
          "scheduleId": {
            "resolvedBy": "getSchedules"
          }
        },
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateShiftRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Created shift",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Shift"
                }
              }
            }
          }
        }
      }
    },
    "/api/shifts/{shiftId}": {
      "delete": {
        "tags": [
          "Shifts"
        ],
        "operationId": "deleteShift",
        "x-operation-type": "mutation",
        "x-intent": [
          "delete shift",
          "remove shift",
          "cancel shift"
        ],
        "parameters": [
          {
            "name": "shiftId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Deleted"
          }
        }
      }
    },
    "/api/health": {
      "get": {
        "tags": [
          "System"
        ],
        "operationId": "healthCheck",
        "x-operation-type": "query",
        "x-intent": [
          "check api health",
          "is system running"
        ],
        "responses": {
          "200": {
            "description": "API is healthy"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Employee": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "firstName": {
            "type": "string"
          },
          "lastName": {
            "type": "string"
          },
          "roleId": {
            "type": "integer",
            "description": "1 = Employee, 2 = Supervisor"
          }
        }
      },
      "Schedule": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "name": {
            "type": "string"
          },
          "startDate": {
            "type": "string"
          },
          "endDate": {
            "type": "string"
          }
        }
      },
      "Shift": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "employeeId": {
            "type": "integer"
          },
          "scheduleId": {
            "type": "integer"
          },
          "employeeName": {
            "type": "string"
          },
          "start": {
            "type": "string",
            "format": "date-time"
          },
          "durationHours": {
            "type": "integer"
          }
        }
      },
      "CreateEmployeeRequest": {
        "type": "object",
        "required": [
          "firstName",
          "lastName"
        ],
        "properties": {
          "firstName": {
            "type": "string"
          },
          "lastName": {
            "type": "string"
          },
          "roleId": {
            "type": "integer"
          }
        }
      },
      "UpdateEmployeeRequest": {
        "type": "object",
        "properties": {
          "firstName": {
            "type": "string"
          },
          "lastName": {
            "type": "string"
          },
          "roleId": {
            "type": "integer"
          }
        }
      },
      "CreateScheduleRequest": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          }
        }
      },
      "CreateShiftRequest": {
        "type": "object",
        "required": [
          "employeeId",
          "start",
          "durationHours",
          "scheduleId"
        ],
        "properties": {
          "employeeId": {
            "type": "integer"
          },
          "start": {
            "type": "string"
          },
          "durationHours": {
            "type": "integer"
          },
          "scheduleId": {
            "type": "integer"
          }
        }
      },
      "LoginRequest": {
        "type": "object",
        "properties": {
          "username": {
            "type": "string"
          },
          "password": {
            "type": "string"
          }
        }
      }
    }
  }
}