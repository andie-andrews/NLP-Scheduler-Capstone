# Create a local file at app/.env (this file is ignored by git).
# You can copy this file to app/.env and fill in your values.

# API target (local development)
SCHEDULER_API_BASE_URL=https://localhost:7259
SCHEDULER_API_VERIFY_SSL=false

# Required for assistant features
OPENAI_API_KEY=your_openai_api_key

# Optional toggle
USE_ORCHESTRATOR_V2=true

# Optional: comma-separated CORS origins for assistant_api.py
ASSISTANT_API_ALLOW_ORIGINS=http://localhost:5173
ASSISTANT_SESSION_TTL_SECONDS=28800
