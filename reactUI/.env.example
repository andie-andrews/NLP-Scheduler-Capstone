# Scheduler REST API base URL used by Login / Schedules / Shifts pages
VITE_SCHEDULER_API_BASE_URL=https://localhost:7259

# Employee REST API base URL used by Employees pages and employee schedule endpoints
VITE_EMPLOYEE_API_BASE_URL=https://localhost:7269

# Reserved for future client-side TLS toggles (currently informational)
VITE_SCHEDULER_API_VERIFY_SSL=true

# AI assistant backend endpoint (this repo's Python endpoint lives at app/assistant_api.py)
# Example: http://localhost:8000/api/assistant/chat
VITE_AI_ASSISTANT_URL=http://localhost:8000/api/assistant/chat
